# Run all backend services from the project root to share this file and database.
MARKETPULSE_DATABASE_PATH=data/marketpulse.sqlite3
MARKETPULSE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MARKETPULSE_WEBSOCKET_URL=wss://data-stream.binance.vision
MARKETPULSE_BATCH_SIZE=250
MARKETPULSE_FLUSH_INTERVAL=1.0
MARKETPULSE_QUEUE_SIZE=10000
MARKETPULSE_RECONNECT_BASE=1.0
MARKETPULSE_RECONNECT_MAX=60.0
MARKETPULSE_STABLE_CONNECTION_SECONDS=60.0
MARKETPULSE_OPEN_TIMEOUT=15.0
MARKETPULSE_RECEIVE_TIMEOUT=60.0
MARKETPULSE_LOG_LEVEL=INFO
MARKETPULSE_DISPLAY_TRADES=true

# For sustained Windows collection, use an absolute local path outside OneDrive.
# Choose your own unsynchronized local directory; see docs/database_relocation.md.
# Preserve existing data with SQLite backup before changing DATABASE_PATH; see README.

# Event-time analytics: these settings must agree between the worker and the API.
MARKETPULSE_ANALYTICS__WINDOW_SECONDS=60
MARKETPULSE_ANALYTICS__ALLOWED_LATENESS_SECONDS=10
MARKETPULSE_ANALYTICS__HISTORY_SIZE=60
MARKETPULSE_ANALYTICS__MIN_HISTORY=20
MARKETPULSE_ANALYTICS__MIN_IMBALANCE_TRADES=20
MARKETPULSE_ANALYTICS__MIN_IMBALANCE_QUOTE_VOLUME=1000
MARKETPULSE_ANALYTICS__MIN_ABSOLUTE_IMBALANCE=0.8
MARKETPULSE_ANALYTICS__RELATIVE_SCALE_FLOOR=0.01
MARKETPULSE_ANALYTICS__ALERT_THRESHOLD=50
# Map overrides are JSON; specify all four detectors.
# MARKETPULSE_ANALYTICS__WEIGHTS={"volume":1,"volatility":1,"imbalance":1,"price_shock":1}
# MARKETPULSE_ANALYTICS__THRESHOLDS={"volume":3.5,"volatility":3.5,"imbalance":3.5,"price_shock":3.5}
# MARKETPULSE_ANALYTICS__REQUIRED_DETECTORS=["volume","volatility","imbalance","price_shock"]
MARKETPULSE_ANALYTICS_PAGE_SIZE=2000
MARKETPULSE_ANALYTICS_MAX_WINDOWS=1000
MARKETPULSE_ANALYTICS_POLL_INTERVAL=2.0

# Phase 4 research policy; independent of the Phase 2 detector policy.
MARKETPULSE_CROSS_ASSET__LOOKBACK=60
MARKETPULSE_CROSS_ASSET__MIN_PAIRS=30
MARKETPULSE_CROSS_ASSET__MIN_COVERAGE=0.8
MARKETPULSE_CROSS_ASSET__BASELINE_WINDOWS=60
MARKETPULSE_CROSS_ASSET__MIN_BASELINE=20
MARKETPULSE_CROSS_ASSET__CORRELATION_SCALE_FLOOR=0.05
MARKETPULSE_CROSS_ASSET__DEVIATION_THRESHOLD=3.5
MARKETPULSE_CROSS_ASSET__MIN_CORRELATION_CHANGE=0.2
MARKETPULSE_CROSS_ASSET__MAX_LAG=3
MARKETPULSE_CROSS_ASSET__OOS_ENABLED=false
MARKETPULSE_CROSS_ASSET__TRAIN_FRACTION=0.7
MARKETPULSE_CROSS_ASSET__OOS_MIN_PAIRS=10
MARKETPULSE_CROSS_ASSET__SYNCHRONIZATION_THRESHOLD=0.8
MARKETPULSE_CROSS_ASSET__VOLATILITY_MULTIPLIER=2.0
MARKETPULSE_CROSS_ASSET__VOLATILITY_FLOOR=0.000001
MARKETPULSE_CROSS_ASSET_BATCH_SIZE=128
MARKETPULSE_CROSS_ASSET_POLL_INTERVAL=5.0
